{
  "name": "sistema-asignacion-clases",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:auth:emulator": "node tests/integration/auth-session.integration.ts",
    "test:provisioning:emulator": "node tests/integration/provisioning-and-scope.integration.ts",
    "test:academic:emulator": "node tests/integration/academic-offer.integration.ts",
    "test:teachers:emulator": "node tests/integration/teachers-and-load.integration.ts",
    "test:schedules:emulator": "node tests/integration/schedules-and-classrooms.integration.ts",
    "emulators:start": "firebase emulators:start --only auth,firestore --project demo-sistema-asignacion"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.4.0",
    "lucide-react": "^0.542.0",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "10.5.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "postcss": "8.5.15",
    "tailwindcss": "3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
